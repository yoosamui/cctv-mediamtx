<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CCTV Live Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #0b0e14;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            padding: 1.5rem;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
        }

        /* ===== TOP BANNER ===== */
        .banner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 0.8rem;
            background: #1e2630;
            padding: 0.7rem 1.8rem;
            border-radius: 60px;
            border: 1px solid rgba(255, 255, 255, 0.06);
            margin-bottom: 2rem;
        }

        .banner-left { flex: 0 0 auto; }

        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: #2a3542;
            color: #d4e2f0;
            font-weight: 600;
            font-size: 0.95rem;
            padding: 0.5rem 1.2rem 0.5rem 1rem;
            border-radius: 40px;
            text-decoration: none;
            border: 1px solid #3d4b5c;
            transition: all 0.2s ease;
            box-shadow: 0 2px 0 #0f141c;
        }

        .back-btn i { color: #7f9bbf; transition: transform 0.2s ease; }
        .back-btn:hover {
            background: #314052;
            border-color: #5b7393;
            color: white;
            transform: translateY(-1px);
        }
        .back-btn:hover i { transform: translateX(-3px); color: #aac3e6; }

        .banner-center {
            flex: 1 1 auto;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 0.5rem 0.75rem;
            flex-wrap: wrap;
        }

        .cctv-title {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-weight: 600;
            font-size: 1.3rem;
            color: #ecf3fa;
        }
        .cctv-title i { color: #5f8ec9; font-size: 1.4rem; }
        .cctv-title .highlight {
            background: linear-gradient(135deg, #b7d6ff, #6b9ef0);
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .cctv-sub {
            font-size: 0.75rem;
            color: #8fa3bb;
            background: #1e2a36;
            padding: 0.2rem 0.8rem;
            border-radius: 40px;
            border: 1px solid #2e3d4e;
        }
        .cctv-sub i { color: #72b0ff; font-size: 0.6rem; }

        .banner-right {
            flex: 0 0 auto;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .live-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            background: #1f2b38;
            padding: 0.4rem 1.2rem 0.4rem 1rem;
            border-radius: 60px;
            border: 1px solid #3d5a70;
            box-shadow: 0 0 12px rgba(255, 70, 70, 0.15);
        }

        .live-badge .dot {
            display: inline-block;
            width: 12px;
            height: 12px;
            background: #ff3b3b;
            border-radius: 50%;
            box-shadow: 0 0 12px #ff3b3b;
            animation: pulse 1.4s infinite ease-in-out;
        }

        @keyframes pulse {
            0% { opacity: 0.5; transform: scale(0.85); }
            50% { opacity: 1; transform: scale(1.1); }
            100% { opacity: 0.5; transform: scale(0.85); }
        }

        .live-badge .label {
            font-weight: 700;
            font-size: 1rem;
            letter-spacing: 1.2px;
            background: linear-gradient(180deg, #ffbaba, #ff6b6b);
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-transform: uppercase;
        }

        .link-hint {
            color: #5b748f;
            background: #16202b;
            padding: 0.3rem 0.7rem;
            border-radius: 40px;
            border: 1px solid #2f4053;
            text-decoration: none;
            transition: 0.2s;
        }
        .link-hint:hover { background: #1f3142; color: #b6ceec; }

        /* ===== VIDEO GRID ===== */
        .video-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 1.5rem;
            margin-top: 1rem;
        }

        .video-card {
            background: #131a22;
            border-radius: 1.5rem;
            overflow: hidden;
            border: 1px solid #252f3b;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5);
            transition: transform 0.2s, border-color 0.2s;
        }

        .video-card:hover {
            transform: translateY(-3px);
            border-color: #3f5b78;
        }

        .video-wrapper {
            position: relative;
            background: #0a0e13;
            aspect-ratio: 16 / 9;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .video-wrapper video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            background: #0a0e13;
        }

        .video-wrapper .fallback-msg {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #6a7f99;
            font-size: 0.85rem;
            gap: 0.5rem;
            background: #0f161e;
            padding: 1rem;
            text-align: center;
            pointer-events: none;
        }

        .video-wrapper .fallback-msg i { font-size: 2rem; color: #3a5068; }
        .video-wrapper .fallback-msg code {
            background: #1e2a36;
            padding: 0.3rem 0.8rem;
            border-radius: 6px;
            font-size: 0.7rem;
            color: #b0c7e0;
        }

        .video-card .card-footer {
            padding: 0.8rem 1.2rem;
            background: #10171f;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid #1f2935;
        }

        .video-card .card-footer .cam-name {
            color: #c8d8ea;
            font-weight: 500;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }
        .video-card .card-footer .cam-name i { color: #5f8ec9; }

        .video-card .card-footer .status {
            font-size: 0.7rem;
            padding: 0.2rem 0.7rem;
            border-radius: 40px;
            background: #1d2c3b;
            color: #ff6b6b;
            border: 1px solid #5a2e2e;
        }
        .status.live i { font-size: 0.5rem; margin-right: 4px; }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 700px) {
            .banner {
                flex-wrap: wrap;
                justify-content: center;
                padding: 0.8rem 1.2rem;
                gap: 0.6rem;
            }
            .banner-center { order: 3; flex: 1 1 100%; }
            .cctv-title { font-size: 1.1rem; }
            .video-grid { grid-template-columns: 1fr; }
        }

        @media (max-width: 480px) {
            .banner-left, .banner-right { flex: 1 1 40%; }
            .banner-center { flex: 1 1 100%; }
            .back-btn { font-size: 0.8rem; padding: 0.3rem 0.9rem; }
            .live-badge { padding: 0.2rem 0.8rem; }
            .live-badge .label { font-size: 0.8rem; }
        }
    </style>
</head>
<body>

